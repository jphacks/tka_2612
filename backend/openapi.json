{
  "openapi": "3.1.0",
  "info": {
    "title": "tka_2612 API",
    "version": "0.1.0"
  },
  "paths": {
    "/cocktails": {
      "get": {
        "tags": [
          "cocktails"
        ],
        "summary": "List Cocktails",
        "description": "登録されているお酒の一覧",
        "operationId": "list_cocktails",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Cocktail"
                  },
                  "type": "array",
                  "title": "Response List Cocktails"
                }
              }
            }
          }
        }
      }
    },
    "/cocktails/{cocktail_id}": {
      "get": {
        "tags": [
          "cocktails"
        ],
        "summary": "Get Cocktail",
        "description": "お酒の詳細",
        "operationId": "get_cocktail",
        "parameters": [
          {
            "name": "cocktail_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cocktail Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cocktail"
                }
              }
            }
          },
          "404": {
            "description": "お酒が見つからない"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/menu/scan": {
      "post": {
        "tags": [
          "menu"
        ],
        "summary": "Scan Menu",
        "description": "メニューの写真から、載っているお酒の名前を AI（Gemini）で読み取る\n\n読み取った名前は、そのまま `/menu/match` に渡すとデータベースのお酒と照合できる。",
        "operationId": "scan_menu",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_scan_menu"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuScanResponse"
                }
              }
            }
          },
          "413": {
            "description": "画像が大きすぎる（10MB まで）"
          },
          "415": {
            "description": "画像ではないファイル"
          },
          "503": {
            "description": "Gemini が使えない（API キー未設定・回数制限など）"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/menu/match": {
      "post": {
        "tags": [
          "menu"
        ],
        "summary": "Match Menu",
        "description": "メニューに載っているお酒の名前を、データベースのお酒と照合する\n\n同じお酒に何度も一致したときは、最初の1件だけを返す。",
        "operationId": "match_menu",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MenuMatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuMatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recommendations": {
      "post": {
        "tags": [
          "recommendations"
        ],
        "summary": "Recommend",
        "description": "入力文（味の希望や気分）に合うお酒を、一致度の高い順に上位5件返す\n\n`cocktail_ids` を渡すと、その中からだけ選ぶ（メニューの写真から照合したお酒など）。\n省略すると、データベース全体から選ぶ。一致度は入力文とお酒の説明文のコサイン類似度。",
        "operationId": "recommend",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendResponse"
                }
              }
            }
          },
          "422": {
            "description": "存在しないお酒のIDが含まれている"
          },
          "503": {
            "description": "Gemini が使えない（API キー未設定・回数制限など）"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_scan_menu": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "description": "メニューの写真（JPEG・PNG など）"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_scan_menu"
      },
      "Cocktail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "お酒のID"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "お酒の名前（日本語）"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases",
            "description": "照合用の別名（英名・表記ゆれなど）"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "味・香り、度数の目安、合う場面・気分の説明文"
          },
          "ingredients": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Ingredients",
            "description": "材料"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "aliases",
          "description",
          "ingredients"
        ],
        "title": "Cocktail",
        "description": "お酒の情報（ベクトルは API では返さない）"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchedCocktail": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "メニューに書かれていた名前"
          },
          "cocktail": {
            "$ref": "#/components/schemas/Cocktail"
          }
        },
        "type": "object",
        "required": [
          "name",
          "cocktail"
        ],
        "title": "MatchedCocktail",
        "description": "データベースのお酒と一致した名前"
      },
      "MenuMatchRequest": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Names",
            "description": "メニューから読み取ったお酒の名前（価格などが付いていてもよい）"
          }
        },
        "type": "object",
        "required": [
          "names"
        ],
        "title": "MenuMatchRequest",
        "description": "メニューに載っているお酒の名前"
      },
      "MenuMatchResponse": {
        "properties": {
          "matched": {
            "items": {
              "$ref": "#/components/schemas/MatchedCocktail"
            },
            "type": "array",
            "title": "Matched",
            "description": "データベースのお酒と一致したもの"
          },
          "unregistered": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unregistered",
            "description": "データベースにないお酒の名前"
          }
        },
        "type": "object",
        "required": [
          "matched",
          "unregistered"
        ],
        "title": "MenuMatchResponse",
        "description": "照合の結果"
      },
      "MenuScanResponse": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Names",
            "description": "メニューに載っているお酒の名前（載っている順、重複なし）"
          }
        },
        "type": "object",
        "required": [
          "names"
        ],
        "title": "MenuScanResponse",
        "description": "メニューの写真から読み取った結果"
      },
      "RecommendRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query",
            "description": "味の希望や、シーン・気分を表す文（例: 甘くてフルーティ、失恋を支えてくれるお酒）"
          },
          "cocktail_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Cocktail Ids",
            "description": "候補にするお酒のID（メニューの写真から照合したものなど）。省略するとデータベース全体から選ぶ"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "RecommendRequest",
        "description": "おすすめのリクエスト"
      },
      "RecommendResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "入力文"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            },
            "type": "array",
            "title": "Recommendations",
            "description": "一致度の高い順のおすすめ（上位5件まで）"
          }
        },
        "type": "object",
        "required": [
          "query",
          "recommendations"
        ],
        "title": "RecommendResponse",
        "description": "おすすめの結果"
      },
      "Recommendation": {
        "properties": {
          "cocktail": {
            "$ref": "#/components/schemas/Cocktail"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "一致度（入力文とお酒の説明文のコサイン類似度）"
          }
        },
        "type": "object",
        "required": [
          "cocktail",
          "score"
        ],
        "title": "Recommendation",
        "description": "おすすめ1件"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
