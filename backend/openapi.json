{
  "openapi": "3.1.0",
  "info": {
    "title": "tka_2612 API",
    "version": "0.1.0"
  },
  "paths": {
    "/cocktails": {
      "get": {
        "tags": [
          "cocktails"
        ],
        "summary": "List Cocktails",
        "description": "登録されているお酒の一覧",
        "operationId": "list_cocktails",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Cocktail"
                  },
                  "type": "array",
                  "title": "Response List Cocktails"
                }
              }
            }
          }
        }
      }
    },
    "/cocktails/vectors": {
      "get": {
        "tags": [
          "cocktails"
        ],
        "summary": "List Cocktail Vectors",
        "description": "登録されているお酒のベクトルの一覧（フロントエンドで次元削減して表示する用）",
        "operationId": "list_cocktail_vectors",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CocktailVector"
                  },
                  "type": "array",
                  "title": "Response List Cocktail Vectors"
                }
              }
            }
          }
        }
      }
    },
    "/cocktails/{cocktail_id}": {
      "get": {
        "tags": [
          "cocktails"
        ],
        "summary": "Get Cocktail",
        "description": "お酒の詳細",
        "operationId": "get_cocktail",
        "parameters": [
          {
            "name": "cocktail_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cocktail Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cocktail"
                }
              }
            }
          },
          "404": {
            "description": "お酒が見つからない"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cocktails/search": {
      "post": {
        "tags": [
          "cocktails"
        ],
        "summary": "Search Cocktails",
        "description": "入力文をベクトル化し、ベクトルが近い順（一致度の高い順）にお酒を100件返す\n\n一致度は入力文とお酒の説明文のコサイン類似度。データベース全体から探す。",
        "operationId": "search_cocktails",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "503": {
            "description": "Gemini が使えない（API キー未設定・回数制限など）"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/menu/scan": {
      "post": {
        "tags": [
          "menu"
        ],
        "summary": "Scan Menu",
        "description": "メニューの写真から、載っているお酒の名前と写真上の位置を AI（Gemini）で読み取る\n\n`x`・`y` は名前の中心の位置（写真の幅・高さに対する %）。読み取れなかったときは null。\n読み取った名前は、そのまま `/menu/match` に渡すとデータベースのお酒と照合できる。",
        "operationId": "scan_menu",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_scan_menu"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuScanResponse"
                }
              }
            }
          },
          "413": {
            "description": "画像が大きすぎる（10MB まで）"
          },
          "415": {
            "description": "画像ではないファイル"
          },
          "503": {
            "description": "Gemini が使えない（API キー未設定・回数制限など）"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/menu/match": {
      "post": {
        "tags": [
          "menu"
        ],
        "summary": "Match Menu",
        "description": "メニューに載っているお酒の名前を、データベースのお酒と照合する\n\n同じお酒に何度も一致したときは、最初の1件だけを返す。",
        "operationId": "match_menu",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MenuMatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuMatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recommendations": {
      "post": {
        "tags": [
          "recommendations"
        ],
        "summary": "Recommend",
        "description": "入力文（味の希望や気分）に合うお酒を、一致度の高い順に上位5件返す\n\n`cocktail_ids` を渡すと、その中からだけ選ぶ（メニューの写真から照合したお酒など）。\n省略すると、データベース全体から選ぶ。一致度は入力文とお酒の説明文のコサイン類似度。\nおすすめを返せたときは、入力文を店舗向けの集計のために記録する（誰が入力したかは記録しない）。",
        "operationId": "recommend",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendResponse"
                }
              }
            }
          },
          "422": {
            "description": "存在しないお酒のIDが含まれている"
          },
          "503": {
            "description": "Gemini が使えない（API キー未設定・回数制限など）"
          }
        }
      }
    },
    "/favorites": {
      "post": {
        "tags": [
          "favorites"
        ],
        "summary": "Add Favorite",
        "description": "お気に入りに登録する（登録済みなら何もしない）",
        "operationId": "add_favorite",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FavoriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FavoriteStatus"
                }
              }
            }
          },
          "404": {
            "description": "お酒が見つからない"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "favorites"
        ],
        "summary": "List Favorites",
        "description": "端末のお気に入りのお酒（新しく登録した順）",
        "operationId": "list_favorites",
        "parameters": [
          {
            "name": "device_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "ブラウザごとのランダムな端末ID",
              "title": "Device Id"
            },
            "description": "ブラウザごとのランダムな端末ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cocktail"
                  },
                  "title": "Response List Favorites"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/favorites/{cocktail_id}": {
      "delete": {
        "tags": [
          "favorites"
        ],
        "summary": "Remove Favorite",
        "description": "お気に入りから外す（未登録なら何もしない）",
        "operationId": "remove_favorite",
        "parameters": [
          {
            "name": "cocktail_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cocktail Id"
            }
          },
          {
            "name": "device_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "ブラウザごとのランダムな端末ID",
              "title": "Device Id"
            },
            "description": "ブラウザごとのランダムな端末ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FavoriteStatus"
                }
              }
            }
          },
          "404": {
            "description": "お酒が見つからない"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/favorites/counts": {
      "get": {
        "tags": [
          "favorites"
        ],
        "summary": "List Favorite Counts",
        "description": "お気に入りの総数が多い順のお酒（1件以上のもの）",
        "operationId": "list_favorite_counts",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FavoriteCount"
                  },
                  "type": "array",
                  "title": "Response List Favorite Counts"
                }
              }
            }
          }
        }
      }
    },
    "/store/queries": {
      "get": {
        "tags": [
          "store"
        ],
        "summary": "List Popular Queries",
        "description": "よく求められた味（おすすめで入力された文）を、回数の多い順に返す\n\n店舗向けの集計。全角半角と空白の違いはそろえて数える。回数が同じなら最近入力された順。",
        "operationId": "list_popular_queries",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "返す件数（最大100）",
              "default": 20,
              "title": "Limit"
            },
            "description": "返す件数（最大100）"
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 365,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "直近何日分を数えるか。省略するとすべての期間",
              "title": "Days"
            },
            "description": "直近何日分を数えるか。省略するとすべての期間"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QueryCount"
                  },
                  "title": "Response List Popular Queries"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/store/keywords": {
      "get": {
        "tags": [
          "store"
        ],
        "summary": "List Popular Keywords",
        "description": "検索履歴でよく使われた言葉を、回数の多い順に返す（ワードクラウド・ランキング用）\n\nおすすめで入力された文を単語に分け、意味のある言葉（名詞・形容詞・副詞・動詞）だけを数える。\n「お酒」「飲む」のように好みの手がかりにならない言葉は除く。\n`count` はその言葉を含む検索の回数、`weight` はいちばん多い言葉を 1 とした割合。",
        "operationId": "list_popular_keywords",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "返す言葉の数（最大200）",
              "default": 50,
              "title": "Limit"
            },
            "description": "返す言葉の数（最大200）"
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 365,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "直近何日分を数えるか。省略するとすべての期間",
              "title": "Days"
            },
            "description": "直近何日分を数えるか。省略するとすべての期間"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KeywordCount"
                  },
                  "title": "Response List Popular Keywords"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_scan_menu": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "description": "メニューの写真（JPEG・PNG など）"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_scan_menu"
      },
      "Cocktail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "お酒のID"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "お酒の名前（日本語）"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases",
            "description": "照合用の別名（英名・表記ゆれなど）"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "味・香り、度数の目安、合う場面・気分の説明文"
          },
          "ingredients": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Ingredients",
            "description": "材料"
          },
          "bases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Bases",
            "description": "ベースのお酒のID（ジン・ラムなど。複数のこともある。ノンアルコールは空）"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "aliases",
          "description",
          "ingredients",
          "bases"
        ],
        "title": "Cocktail",
        "description": "お酒の情報（ベクトルは API では返さない）"
      },
      "CocktailVector": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "お酒のID"
          },
          "vector": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Vector",
            "description": "説明文の埋め込みベクトル（gemini-embedding-2、768次元）"
          }
        },
        "type": "object",
        "required": [
          "id",
          "vector"
        ],
        "title": "CocktailVector",
        "description": "お酒の説明文の埋め込みベクトル"
      },
      "FavoriteCount": {
        "properties": {
          "cocktail": {
            "$ref": "#/components/schemas/Cocktail"
          },
          "favorite_count": {
            "type": "integer",
            "title": "Favorite Count",
            "description": "お気に入りの総数（全端末）"
          }
        },
        "type": "object",
        "required": [
          "cocktail",
          "favorite_count"
        ],
        "title": "FavoriteCount",
        "description": "お酒ごとのお気に入りの総数"
      },
      "FavoriteRequest": {
        "properties": {
          "device_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Device Id",
            "description": "ブラウザごとのランダムな端末ID"
          },
          "cocktail_id": {
            "type": "string",
            "title": "Cocktail Id",
            "description": "お酒のID"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "cocktail_id"
        ],
        "title": "FavoriteRequest",
        "description": "お気に入りの登録"
      },
      "FavoriteStatus": {
        "properties": {
          "cocktail_id": {
            "type": "string",
            "title": "Cocktail Id",
            "description": "お酒のID"
          },
          "favorited": {
            "type": "boolean",
            "title": "Favorited",
            "description": "この端末でお気に入りに登録されているか"
          },
          "favorite_count": {
            "type": "integer",
            "title": "Favorite Count",
            "description": "このお酒のお気に入りの総数（全端末）"
          }
        },
        "type": "object",
        "required": [
          "cocktail_id",
          "favorited",
          "favorite_count"
        ],
        "title": "FavoriteStatus",
        "description": "お気に入りの登録・解除の結果"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KeywordCount": {
        "properties": {
          "word": {
            "type": "string",
            "title": "Word",
            "description": "言葉（形容詞などは基本形にそろえてある。例: 甘く → 甘い）"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "この言葉を含む検索の回数"
          },
          "weight": {
            "type": "number",
            "title": "Weight",
            "description": "表示の大きさの目安（いちばん多い言葉を 1 とした割合、0〜1）"
          }
        },
        "type": "object",
        "required": [
          "word",
          "count",
          "weight"
        ],
        "title": "KeywordCount",
        "description": "検索履歴でよく使われた言葉（ワードクラウド・ランキング用）"
      },
      "MatchedCocktail": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "メニューに書かれていた名前"
          },
          "cocktail": {
            "$ref": "#/components/schemas/Cocktail"
          }
        },
        "type": "object",
        "required": [
          "name",
          "cocktail"
        ],
        "title": "MatchedCocktail",
        "description": "データベースのお酒と一致した名前"
      },
      "MenuMatchRequest": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Names",
            "description": "メニューから読み取ったお酒の名前（価格などが付いていてもよい）"
          }
        },
        "type": "object",
        "required": [
          "names"
        ],
        "title": "MenuMatchRequest",
        "description": "メニューに載っているお酒の名前"
      },
      "MenuMatchResponse": {
        "properties": {
          "matched": {
            "items": {
